# Build modeldock-exporter binary
ARG BASE_IMAGE=golang:1.26
FROM ${BASE_IMAGE} AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY api/ api/
COPY pkg/ pkg/
COPY cmd/modeldock-exporter/ cmd/modeldock-exporter/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o modeldock-exporter ./cmd/modeldock-exporter/main.go

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/modeldock-exporter .
USER 65532:65532

ENTRYPOINT ["/modeldock-exporter"]
